{
  "name": "weft",
  "productName": "Weft",
  "version": "0.6.0",
  "description": "A board for your AI",
  "author": "Alex Miller <fotoflo@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimhuge/weft.git"
  },
  "homepage": "https://github.com/aimhuge/weft#readme",
  "bugs": "https://github.com/aimhuge/weft/issues",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node electron/free-port.cjs 1024 .next && next dev -H 127.0.0.1 -p 1024",
    "dev:web": "node electron/free-port.cjs 1024 .next && WEFT_WEB=1 next dev -H 127.0.0.1 -p 1024",
    "dev:protocol": "node scripts/dev-protocol.cjs",
    "desktop": "node scripts/dev-protocol.cjs && electron .",
    "build": "next build",
    "start": "electron .",
    "lint": "node scripts/one-at-a-time.mjs lint eslint --max-warnings 0",
    "typecheck": "node scripts/one-at-a-time.mjs typecheck 'next typegen && tsc --noEmit'",
    "test": "node scripts/run-tests.mjs",
    "welcome:render": "node scripts/render-welcome-loop.mjs",
    "welcome:narrate": "node scripts/narrate-welcome.mjs",
    "intros:narrate": "node scripts/narrate-intros.mjs",
    "levels:narrate": "node scripts/narrate-levels.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "app": "WEFT_DIST=.next-app next build && WEFT_DIST=.next-app WEFT_PROD=1 electron .",
    "dist": "WEFT_DIST=.next-dist WEFT_STANDALONE=1 next build && node scripts/prepare-standalone.mjs .next-dist && node scripts/bundle-toolchain.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "dist:linux": "WEFT_DIST=.next-dist WEFT_STANDALONE=1 next build && node scripts/prepare-standalone.mjs .next-dist && node scripts/bundle-toolchain.mjs && electron-builder --linux --publish never",
    "dist:remote": "scripts/package-remote.sh",
    "dist:release": "WEFT_DIST=.next-dist WEFT_STANDALONE=1 next build && node scripts/prepare-standalone.mjs .next-dist && node scripts/bundle-toolchain.mjs && electron-builder --mac --publish never",
    "coverage": "node scripts/run-tests.mjs --coverage",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true; node scripts/patch-next-hmr.mjs",
    "resend": "node scripts/resend-domain.mjs",
    "league:test-mail": "jiti scripts/league-mail-test.ts",
    "changelog:release": "jiti scripts/changelog-release.ts"
  },
  "dependencies": {
    "@aimhuge/admin": "github:aimhuge/components#v0.7.0&path:/packages/admin",
    "@aimhuge/billing": "github:aimhuge/components#v0.5.0&path:/packages/billing",
    "@aimhuge/share": "github:aimhuge/components#v0.8.0&path:/packages/share",
    "@aimhuge/teams": "file:vendor/aimhuge-teams-0.1.0.tgz",
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "0.28.2",
    "libsodium-wrappers": "^0.7.16",
    "lucide-react": "^1.56.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.3",
    "node-diff3": "^3.2.1",
    "node-pty": "^1.1.0",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "22.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^21.0.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "app.weft.desktop",
    "productName": "Weft",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules${/*}",
      "node_modules/libsodium/**/*",
      "node_modules/libsodium-wrappers/**/*",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/lib/**/*",
      "node_modules/node-pty/prebuilds/darwin-${arch}/**/*",
      "node_modules/node-pty/build/Release/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".next-dist/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next-dist/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".toolchain-dist",
        "to": "toolchain",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugin",
        "to": "plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Weft",
        "schemes": [
          "weft"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "weft",
      "artifactName": "Weft-${version}-${arch}.${ext}",
      "mimeTypes": [
        "x-scheme-handler/weft"
      ],
      "maintainer": "Weft <noreply@weft.zip>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Weft opens Terminal to run a command-line tool's login when it needs a real terminal.",
        "NSDownloadsFolderUsageDescription": "Weft's threads read files you save to Downloads, like audio to transcribe or screenshots to look at.",
        "NSMicrophoneUsageDescription": "Weft listens when you press the mic button, to type your prompt for you. The audio is transcribed on this Mac.",
        "LSUIElement": false
      },
      "artifactName": "Weft-${version}-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "unrs-resolver"
    ],
    "overrides": {
      "tinypool": "^2.1.2",
      "braces": "^3.0.3",
      "sprintf-js": "^1.1.3"
    }
  }
}
