{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-app/types/**/*.ts",
    ".next-app/dev/types/**/*.ts",
    ".next-dist/types/**/*.ts",
    ".next-dist/dev/types/**/*.ts",
    ".next-scout/types/**/*.ts",
    ".next-scout/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-tprobe/types/**/*.ts",
    ".next-tprobe/dev/types/**/*.ts",
    ".next-upgrade-check/types/**/*.ts",
    ".next-upgrade-check/dev/types/**/*.ts",
    ".next-gogtest/types/**/*.ts",
    ".next-gogtest/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.*",
    "dist",
    "out",
    ".toolchain-dist",
    ".scratch"
  ]
}
