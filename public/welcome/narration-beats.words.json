   0.5,
   7.2,
   "Connect your tools to Weft, so your threads can use them."
  ],
  [
   8,
   14.7,
   "Your vault stores your credentials and lets your AI securely use them."
  ],
  [
   15.2,
   26.2,
   "Panes aren't just previews. They can use keys in your vault to connect to your database or apis, and be shared so a secure live dashboard, mini app or game is just a few clicks away."
  ],
  [
   26.7,
   33.2,
   "Weft also scores your code quality, and Weft's scout keeps your code clean."
  ],
  [
   34,
   43.9,
   "Weft comes with BlastCP built in, so you can easily connect all your social accounts, make images, video and voice for your posts, and build in public."
  ],
  [
   44.7,
   51.2,
   "Share your Wefter Profile, and show the world what you ship."
  ],
  [
   52,
   59.3,
   "Weft is open source. If something is broken, or you want to add a feature, please feel free to make a pullrequest."
  ],
  [
   60,
   63.2,
   "Now let's get started."
  ]
