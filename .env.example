# Names only: Weft reads these from process.env, and the 🔐 vault lists the ones not filled in yet.
# Never put a value here.

# The Weft GitHub App, for GitHub on Weft Workers (docs/architecture/connectors.md#connectors-on-a-worker-github-p1-as-built).
# Set on the weft.zip deployment (production). Register the app at https://github.com/settings/apps/new.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The key weft.zip seals GitHub tokens with at rest: 64 hex chars (openssl rand -hex 32). Optional id, default v1.
WEFT_CONNECTOR_TOKEN_KEY=
WEFT_CONNECTOR_TOKEN_KEY_ID=
# Cloudflare TURN (Realtime → TURN keys), for session lines that can't connect directly: the desktop's /api/rtc-ice
# and weft.zip's /api/web-board/ice mint short-lived credentials with it (lib/rtc-ice.ts). Optional: STUN only without.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# The Weft phone app's TestFlight (docs/architecture/mobile.md#testflight). Set on the weft.zip deployment (production).
# An App Store Connect API key with the App Manager or Admin role: https://appstoreconnect.apple.com/access/integrations/api
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY=
# The external beta group's id (App Store Connect → the app → TestFlight → the group, in its URL) and its public link.
TESTFLIGHT_GROUP_ID=
TESTFLIGHT_PUBLIC_URL=

# weft.zip's lookup of a GitHub account's public email, to tell someone a card was shared with them
# (lib/share-grant-notify.ts). Optional: without it GitHub allows 60 lookups an hour per address. A fine-grained
# token with no permissions is enough: https://github.com/settings/personal-access-tokens/new
GITHUB_LOOKUP_TOKEN=
