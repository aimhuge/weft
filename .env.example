# Names only: Weft reads these from process.env, and the 🔐 vault lists the ones not filled in yet.
# Never put a value here.

# The Weft GitHub App, for GitHub on Weft Workers (docs/architecture/connectors.md#connectors-on-a-worker-github-p1-as-built).
# Set on the weft.zip deployment (production). Register the app at https://github.com/settings/apps/new.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The key weft.zip seals GitHub tokens with at rest: 64 hex chars (openssl rand -hex 32). Optional id, default v1.
WEFT_CONNECTOR_TOKEN_KEY=
WEFT_CONNECTOR_TOKEN_KEY_ID=
